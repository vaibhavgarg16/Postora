# Copy to .env and replace the placeholders. Never commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/reeno"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Optional canonical URL. Leave unset locally so sign-in stays on the host in the browser.
# If this is set, Auth.js redirects there. localhost and 127.0.0.1 do not share cookies.
# AUTH_URL="https://reenoai.com"

# Optional. Google sign-in stays disabled until both are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 32-byte key, base64. Used for social OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=""

# Optional. Without it, development shows verification links on the page.
# Production refuses to finish signup until email can be sent.
RESEND_API_KEY=""
EMAIL_FROM="Reeno AI <noreply@reenoai.com>"

# Optional. Strategy generation stays a labeled starter outline until this is set.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional. Billing shows plans, but checkout refuses until these are set.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Comma-separated emails that can open /admin in addition to PLATFORM_ADMIN users.
PLATFORM_ADMIN_EMAILS=""
